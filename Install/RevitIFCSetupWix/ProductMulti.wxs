<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

   <!--
      E-PYS fork of the Revit IFC exporter: ONE installer that covers several Revit
      versions at once. Each supported version gets its own Autodesk application
      bundle under ProgramData, holding the assemblies built against THAT version's
      Revit API. Revit loads only the bundle whose PackageContents.xml matches the
      running version, so the two sets never collide even though the file names are
      the same.

        C:\ProgramData\Autodesk\ApplicationPlugins\
          IFC 2026.bundle\Contents\2026\   <- built against the Revit 2026 API
          IFC 2027.bundle\Contents\2027\   <- built against the Revit 2027 API

      Each version's files come from Install\epys-stage\<year>\, which build-epys-msi.sh
      populates by building the matching branch (epys/2026 and the 2027 branch):
      the assemblies cannot come from a single build, because each one references a
      different RevitAPI.dll. Note Revit.IFC.Common builds as Revit.IFC.Common.dll
      on the 2026 branch but as Revit.IFC.Common.OpenSource.dll on 2027.

      This product deliberately uses its own Name, Manufacturer and UpgradeCode so
      it is tracked separately from Autodesk's own IFC package and never upgrades
      over it. It also has a different UpgradeCode from the per-version E-PYS MSIs
      built by Product.wxs, so installing this bundle-style package does not silently
      remove a single-version install (and vice versa); uninstall the other one
      first if both were ever installed.
   -->
   <Product Id="*"
            Name="Revit IFC - E-PYS (2026, 2027)"
            Language="1033"
            Version="27.3.12.3"
            Manufacturer="I of BIM"
            UpgradeCode="5F2B8E94-7A16-4D3C-B058-2E9A4C71D63F">

      <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64" />

      <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
      <MediaTemplate EmbedCab="yes" />

      <UI>
         <UIRef Id="WixUI_InstallDir" />
      </UI>
      <!--
         WixUI_InstallDir requires a configurable directory. The bundles must sit at
         their fixed ProgramData locations for Revit to find them, so the browsable
         directory is the shared documentation folder rather than the plug-in itself.
      -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLRESOURCE" />

      <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)..\Program Files to Install\LICENSE.rtf" />
      <WixVariable Id="WixUIBannerBmp" Value="$(var.ProjectDir)..\Program Files to Install\Autodesk Logo.bmp" />
      <WixVariable Id="WixUIDialogBmp" Value="$(var.ProjectDir)..\Program Files to Install\Adsk_sidebar_501x314.jpg" />

      <Feature Id="Feature_2026" Title="IFC for Revit 2026" Level="1"
               Description="E-PYS IFC exporter for Autodesk Revit 2026.">
         <ComponentGroupRef Id="Components2026" />
         <ComponentGroupRef Id="Data2026" />
         <ComponentGroupRef Id="Lang2026" />
         <ComponentGroupRef Id="Manifest2026" />
      </Feature>

      <Feature Id="Feature_2027" Title="IFC for Revit 2027" Level="1"
               Description="E-PYS IFC exporter for Autodesk Revit 2027.">
         <ComponentGroupRef Id="Components2027" />
         <ComponentGroupRef Id="Data2027" />
         <ComponentGroupRef Id="Lang2027" />
         <ComponentGroupRef Id="Manifest2027" />
      </Feature>

      <Feature Id="Feature_Docs" Title="Documentation" Level="1"
               Description="Help file and certification documents.">
         <ComponentGroupRef Id="SharedResources" />
      </Feature>
   </Product>

   <Fragment>
      <Directory Id="TARGETDIR" Name="SourceDir">
         <Directory Id="CommonAppDataFolder">
            <Directory Id="DIR_ADSK" Name="Autodesk">
               <Directory Id="DIR_PLUGINS" Name="ApplicationPlugins">

                  <Directory Id="DIR_BUNDLE_2026" Name="IFC 2026.bundle">
                     <Directory Id="DIR_CONTENTS_2026" Name="Contents">
                        <Directory Id="INSTALLDIR_2026" Name="2026">
                           <Directory Id="DIR_FR_2026" Name="fr" />
                           <Directory Id="DIR_DE_2026" Name="de" />
                           <Directory Id="DIR_TR_2026" Name="tr" />
                        </Directory>
                        <!--
                           PackageContents.xml points its Icon and HelpFile at
                           ".\Contents\Resources\...", relative to the bundle root, so
                           each bundle needs its own Resources folder.
                        -->
                        <Directory Id="DIR_RES_2026" Name="Resources" />
                     </Directory>
                  </Directory>

                  <Directory Id="DIR_BUNDLE_2027" Name="IFC 2027.bundle">
                     <Directory Id="DIR_CONTENTS_2027" Name="Contents">
                        <Directory Id="INSTALLDIR_2027" Name="2027">
                           <Directory Id="DIR_FR_2027" Name="fr" />
                           <Directory Id="DIR_DE_2027" Name="de" />
                           <Directory Id="DIR_TR_2027" Name="tr" />
                        </Directory>
                        <Directory Id="DIR_RES_2027" Name="Resources" />
                     </Directory>
                  </Directory>

               </Directory>
            </Directory>
         </Directory>

         <Directory Id="ProgramFiles64Folder">
            <Directory Id="DIR_ADSK_PF" Name="Autodesk">
               <Directory Id="DIR_IFC_PF" Name="Revit IFC - E-PYS">
                  <Directory Id="INSTALLRESOURCE" Name="Resource" />
               </Directory>
            </Directory>
         </Directory>
      </Directory>
   </Fragment>

   <!-- ============================ Revit 2026 ============================ -->

