<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

   <!--
      E-PYS fork of the Revit IFC exporter: ONE installer for ONE Revit version.

      This single source builds every version's MSI; the year and its identity are
      passed in by build-epys-msi.sh rather than duplicated per version:

        candle.exe -dYear=2027 -dYearVersion=27.3.12.3 \
                   -dYearUpgradeCode=... -dCommonAssembly=Revit.IFC.Common.OpenSource.dll \
                   -dStageDir=... -dManifestDir=... -dProjectDir=...

      The files come from Install\epys-stage\<year>\, which build-epys-msi.sh fills by
      building the branch matching that Revit version: the assemblies cannot come from
      one build, because each references a different RevitAPI.dll.

      Each version gets its own UpgradeCode, so "Revit IFC 2026 - E-PYS" and
      "Revit IFC 2027 - E-PYS" install side by side and each upgrades only its own
      earlier builds. All of them use a Manufacturer and UpgradeCode distinct from
      Autodesk's own IFC package, so none of them ever upgrades over it.

      Installs to the Autodesk application bundle Revit loads by itself:
        C:\ProgramData\Autodesk\ApplicationPlugins\IFC <year>.bundle\Contents\<year>\
   -->
   <Product Id="*"
            Name="Revit IFC $(var.Year) - E-PYS"
            Language="1033"
            Version="$(var.YearVersion)"
            Manufacturer="I of BIM"
            UpgradeCode="$(var.YearUpgradeCode)">

      <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64" />

      <!--
         AllowSameVersionUpgrades is required here, not optional. Product Id="*" mints a
         new ProductCode on every build, but Version only changes when the year's version
         string in build-epys-msi.sh changes. With the WiX default
         (AllowSameVersionUpgrades="no") an equal version is not treated as an upgrade, so
         rebuilding at the same version and reinstalling leaves the previous build
         registered and installs the new one beside it: two "Revit IFC <year> - E-PYS"
         entries in Programs and Features, both writing the same bundle files, and
         uninstalling one then strips files the other still claims.
      -->
      <MajorUpgrade AllowSameVersionUpgrades="yes"
                    DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
      <MediaTemplate EmbedCab="yes" />

      <UI>
         <UIRef Id="WixUI_InstallDir" />
      </UI>
      <!--
         WixUI_InstallDir needs a configurable directory. The bundle has to sit at its
         fixed ProgramData location for Revit to find it, so the browsable directory is
         the documentation folder rather than the plug-in itself.
      -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLRESOURCE" />

      <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)..\Program Files to Install\LICENSE.rtf" />
      <WixVariable Id="WixUIBannerBmp" Value="$(var.ProjectDir)..\Program Files to Install\Autodesk Logo.bmp" />
      <WixVariable Id="WixUIDialogBmp" Value="$(var.ProjectDir)..\Program Files to Install\Adsk_sidebar_501x314.jpg" />

      <Feature Id="ProductFeature" Title="IFC for Revit $(var.Year)" Level="1"
               Description="E-PYS IFC exporter for Autodesk Revit $(var.Year).">
         <ComponentGroupRef Id="Assemblies" />
         <ComponentGroupRef Id="DataFiles" />
         <ComponentGroupRef Id="Languages" />
         <ComponentGroupRef Id="Manifests" />
      </Feature>

      <Feature Id="ProductDocumentation" Title="Documentation" Level="1"
               Description="Help file and certification documents.">
         <ComponentGroupRef Id="SharedResources" />
      </Feature>
   </Product>

   <Fragment>
      <Directory Id="TARGETDIR" Name="SourceDir">
         <Directory Id="CommonAppDataFolder">
            <Directory Id="DIR_ADSK" Name="Autodesk">
               <Directory Id="DIR_PLUGINS" Name="ApplicationPlugins">
                  <Directory Id="DIR_BUNDLE" Name="IFC $(var.Year).bundle">
                     <Directory Id="DIR_CONTENTS" Name="Contents">
                        <Directory Id="INSTALLDIR" Name="$(var.Year)">
                           <Directory Id="DIR_FR" Name="fr" />
                           <Directory Id="DIR_DE" Name="de" />
                           <Directory Id="DIR_TR" Name="tr" />
                        </Directory>
                        <!--
                           PackageContents.xml points its Icon and HelpFile at
                           ".\Contents\Resources\...", relative to the bundle root.
                        -->
                        <Directory Id="DIR_RES" Name="Resources" />
                     </Directory>
                  </Directory>
               </Directory>
            </Directory>
         </Directory>

         <Directory Id="ProgramFiles64Folder">
            <Directory Id="DIR_ADSK_PF" Name="Autodesk">
               <Directory Id="DIR_IFC_PF" Name="Revit IFC $(var.Year) - E-PYS">
                  <Directory Id="INSTALLRESOURCE" Name="Resource" />
               </Directory>
            </Directory>
         </Directory>
      </Directory>
   </Fragment>

   <!--
      Component GUIDs embed the year ($(var.Year) expands inside the GUID's fourth
      group), so each version's MSI owns distinct components and installing one
      never reference-counts against another.
   -->
   <Fragment>
      <ComponentGroup Id="Assemblies" Directory="INSTALLDIR">
         <Component Id="C_UIOverride" Guid="A1B2C3D4-0001-4A01-$(var.Year)-000000000001">
            <File Id="F_UIOverride" Name="IFCExporterUIOverride.dll"
                  Source="$(var.StageDir)$(var.Year)\IFCExporterUIOverride.dll" KeyPath="yes" />
         </Component>
         <Component Id="C_Export" Guid="A1B2C3D4-0002-4A01-$(var.Year)-000000000002">
            <File Id="F_Export" Name="Revit.IFC.Export.dll"
                  Source="$(var.StageDir)$(var.Year)\Revit.IFC.Export.dll" KeyPath="yes" />
         </Component>
         <Component Id="C_Import" Guid="A1B2C3D4-0003-4A01-$(var.Year)-000000000003">
            <File Id="F_Import" Name="Revit.IFC.Import.dll"
                  Source="$(var.StageDir)$(var.Year)\Revit.IFC.Import.dll" KeyPath="yes" />
         </Component>
         <Component Id="C_ImportCore" Guid="A1B2C3D4-0004-4A01-$(var.Year)-000000000004">
            <File Id="F_ImportCore" Name="Revit.IFC.Import.Core.dll"
                  Source="$(var.StageDir)$(var.Year)\Revit.IFC.Import.Core.dll" KeyPath="yes" />
         </Component>
         <!--
            Revit.IFC.Common builds as Revit.IFC.Common.dll on the 2026 branch but as
            Revit.IFC.Common.OpenSource.dll on 2027, so the name is passed in.
         -->
         <Component Id="C_Common" Guid="A1B2C3D4-0005-4A01-$(var.Year)-000000000005">
            <File Id="F_Common" Name="$(var.CommonAssembly)"
                  Source="$(var.StageDir)$(var.Year)\$(var.CommonAssembly)" KeyPath="yes" />
         </Component>
         <Component Id="C_Json" Guid="A1B2C3D4-0006-4A01-$(var.Year)-000000000006">
            <File Id="F_Json" Name="Newtonsoft.Json.dll"
                  Source="$(var.StageDir)$(var.Year)\Newtonsoft.Json.dll" KeyPath="yes" />
         </Component>
         <Component Id="C_Antlr" Guid="A1B2C3D4-0007-4A01-$(var.Year)-000000000007">
            <File Id="F_Antlr" Name="Antlr4.Runtime.dll"
                  Source="$(var.StageDir)$(var.Year)\Antlr4.Runtime.dll" KeyPath="yes" />
         </Component>
         <Component Id="C_Zip" Guid="A1B2C3D4-0008-4A01-$(var.Year)-000000000008">
            <File Id="F_Zip" Name="ICSharpCode.SharpZipLib.dll"
                  Source="$(var.StageDir)$(var.Year)\ICSharpCode.SharpZipLib.dll" KeyPath="yes" />
         </Component>
      </ComponentGroup>

      <ComponentGroup Id="DataFiles" Directory="INSTALLDIR">
         <Component Id="C_D01" Guid="A1B2C3D4-0101-4A01-$(var.Year)-000000000101">
            <File Id="F_D01" Name="IFC2X2_ADD1.exp" Source="$(var.ProjectDir)..\Program Files to Install\IFC2X2_ADD1.exp" KeyPath="yes" />
         </Component>
         <Component Id="C_D02" Guid="A1B2C3D4-0102-4A01-$(var.Year)-000000000102">
            <File Id="F_D02" Name="IFC2X2_ADD1.xsd" Source="$(var.ProjectDir)..\Program Files to Install\IFC2X2_ADD1.xsd" KeyPath="yes" />
         </Component>
         <Component Id="C_D03" Guid="A1B2C3D4-0103-4A01-$(var.Year)-000000000103">
            <File Id="F_D03" Name="IFC2X3_TC1.exp" Source="$(var.ProjectDir)..\Program Files to Install\IFC2X3_TC1.exp" KeyPath="yes" />
         </Component>
         <Component Id="C_D04" Guid="A1B2C3D4-0104-4A01-$(var.Year)-000000000104">
            <File Id="F_D04" Name="IFC2X3_TC1.xsd" Source="$(var.ProjectDir)..\Program Files to Install\IFC2X3_TC1.xsd" KeyPath="yes" />
         </Component>
         <Component Id="C_D05" Guid="A1B2C3D4-0105-4A01-$(var.Year)-000000000105">
            <File Id="F_D05" Name="IFC4.exp" Source="$(var.ProjectDir)..\Program Files to Install\IFC4.exp" KeyPath="yes" />
         </Component>
         <Component Id="C_D06" Guid="A1B2C3D4-0106-4A01-$(var.Year)-000000000106">
            <File Id="F_D06" Name="IFC4.xsd" Source="$(var.ProjectDir)..\Program Files to Install\IFC4.xsd" KeyPath="yes" />
         </Component>
         <Component Id="C_D07" Guid="A1B2C3D4-0107-4A01-$(var.Year)-000000000107">
            <File Id="F_D07" Name="IFC4RV.xsd" Source="$(var.ProjectDir)..\Program Files to Install\IFC4RV.xsd" KeyPath="yes" />
         </Component>
         <Component Id="C_D08" Guid="A1B2C3D4-0108-4A01-$(var.Year)-000000000108">
            <File Id="F_D08" Name="IFC4X3.xsd" Source="$(var.ProjectDir)..\Program Files to Install\IFC4X3.xsd" KeyPath="yes" />
         </Component>
         <Component Id="C_D09" Guid="A1B2C3D4-0109-4A01-$(var.Year)-000000000109">
            <File Id="F_D09" Name="IFCCertifiedEntitiesAndPSets.json" Source="$(var.ProjectDir)..\Program Files to Install\IFCCertifiedEntitiesAndPSets.json" KeyPath="yes" />
         </Component>
         <Component Id="C_D10" Guid="A1B2C3D4-010A-4A01-$(var.Year)-00000000010A">
            <File Id="F_D10" Name="DefaultUserDefinedParameterSets.txt" Source="$(var.ProjectDir)..\Program Files to Install\DefaultUserDefinedParameterSets.txt" KeyPath="yes" />
         </Component>
         <Component Id="C_D11" Guid="A1B2C3D4-010B-4A01-$(var.Year)-00000000010B">
            <File Id="F_D11" Name="IFC2x3 COBie 2.4 Design Deliverable.txt" Source="$(var.ProjectDir)..\Program Files to Install\IFC2x3 COBie 2.4 Design Deliverable.txt" KeyPath="yes" />
         </Component>
         <Component Id="C_D12" Guid="A1B2C3D4-010C-4A01-$(var.Year)-00000000010C">
            <File Id="F_D12" Name="IFC Shared Parameters-RevitIFCBuiltIn_ALL.txt" Source="$(var.ProjectDir)..\Program Files to Install\IFC Shared Parameters-RevitIFCBuiltIn_ALL.txt" KeyPath="yes" />
         </Component>
         <Component Id="C_D13" Guid="A1B2C3D4-010D-4A01-$(var.Year)-00000000010D">
            <File Id="F_D13" Name="IFC Shared Parameters-RevitIFCBuiltIn-Type_ALL.txt" Source="$(var.ProjectDir)..\Program Files to Install\IFC Shared Parameters-RevitIFCBuiltIn-Type_ALL.txt" KeyPath="yes" />
         </Component>
         <Component Id="C_D14" Guid="A1B2C3D4-010E-4A01-$(var.Year)-00000000010E">
            <File Id="F_D14" Name="IFC-SG Property Mapping Export.txt" Source="$(var.ProjectDir)..\Program Files to Install\IFC-SG Property Mapping Export.txt" KeyPath="yes" />
         </Component>
         <Component Id="C_D15" Guid="A1B2C3D4-010F-4A01-$(var.Year)-00000000010F">
            <File Id="F_D15" Name="LICENSE.rtf" Source="$(var.ProjectDir)..\Program Files to Install\LICENSE.rtf" KeyPath="yes" />
         </Component>
      </ComponentGroup>

      <ComponentGroup Id="Languages">
         <Component Id="C_L_FR" Directory="DIR_FR" Guid="A1B2C3D4-0201-4A01-$(var.Year)-000000000201">
            <File Id="F_L_FR" Name="IFCExporterUIOverride.resources.dll"
                  Source="$(var.StageDir)$(var.Year)\fr\IFCExporterUIOverride.resources.dll" KeyPath="yes" />
         </Component>
         <Component Id="C_L_DE" Directory="DIR_DE" Guid="A1B2C3D4-0202-4A01-$(var.Year)-000000000202">
            <File Id="F_L_DE" Name="IFCExporterUIOverride.resources.dll"
                  Source="$(var.StageDir)$(var.Year)\de\IFCExporterUIOverride.resources.dll" KeyPath="yes" />
         </Component>
         <Component Id="C_L_TR" Directory="DIR_TR" Guid="A1B2C3D4-0203-4A01-$(var.Year)-000000000203">
            <File Id="F_L_TR" Name="IFCExporterUIOverride.resources.dll"
                  Source="$(var.StageDir)$(var.Year)\tr\IFCExporterUIOverride.resources.dll" KeyPath="yes" />
         </Component>
      </ComponentGroup>

      <ComponentGroup Id="Manifests">
         <Component Id="C_Pkg" Directory="DIR_BUNDLE" Guid="A1B2C3D4-0301-4A01-$(var.Year)-000000000301">
            <File Id="F_Pkg" Name="PackageContents.xml"
                  Source="$(var.ManifestDir)$(var.Year)\PackageContents.xml" KeyPath="yes" />
         </Component>
         <!--
            The .addin references its assemblies relative to its own folder
            (".\IFCExporterUIOverride.dll") and is installed into that same folder,
            so no XmlFile rewriting is needed.
         -->
         <Component Id="C_Addin" Directory="INSTALLDIR" Guid="A1B2C3D4-0302-4A01-$(var.Year)-000000000302">
            <File Id="F_Addin" Name="Revit.IFC.addin"
                  Source="$(var.ManifestDir)$(var.Year)\Revit.IFC.addin" KeyPath="yes" />
         </Component>
         <Component Id="C_Icon" Directory="DIR_RES" Guid="A1B2C3D4-0303-4A01-$(var.Year)-000000000303">
            <File Id="F_Icon" Name="IFCExporter.png"
                  Source="$(var.ProjectDir)..\Program Files to Install\bundle\Contents\Resources\IFCExporter.png" KeyPath="yes" />
         </Component>
         <Component Id="C_HelpBundle" Directory="DIR_RES" Guid="A1B2C3D4-0304-4A01-$(var.Year)-000000000304">
            <File Id="F_HelpBundle" Name="ADSKIFCExporterHelp.htm"
                  Source="$(var.ProjectDir)..\Program Files to Install\bundle\Contents\Resources\ADSKIFCExporterHelp.htm" KeyPath="yes" />
         </Component>
      </ComponentGroup>

      <ComponentGroup Id="SharedResources" Directory="INSTALLRESOURCE">
         <Component Id="C_Help" Guid="A1B2C3D4-0401-4A01-$(var.Year)-000000000401">
            <File Id="F_Help" Name="ADSKIFCExporterHelp.htm"
                  Source="$(var.ProjectDir)..\Program Files to Install\bundle\Contents\Resources\ADSKIFCExporterHelp.htm" KeyPath="yes" />
         </Component>
         <Component Id="C_CertArch" Guid="A1B2C3D4-0402-4A01-$(var.Year)-000000000402">
            <File Id="F_CertArch" Name="Software Certification Certificate Revit - Architectural export ER.png"
                  Source="$(var.ProjectDir)..\Program Files to Install\bundle\Contents\Resources\Software Certification Certificate Revit - Architectural export ER.png" KeyPath="yes" />
         </Component>
         <Component Id="C_CertStru" Guid="A1B2C3D4-0403-4A01-$(var.Year)-000000000403">
            <File Id="F_CertStru" Name="Software Certification Certificate Revit - Structural export ER.png"
                  Source="$(var.ProjectDir)..\Program Files to Install\bundle\Contents\Resources\Software Certification Certificate Revit - Structural export ER.png" KeyPath="yes" />
         </Component>
      </ComponentGroup>
   </Fragment>
</Wix>
