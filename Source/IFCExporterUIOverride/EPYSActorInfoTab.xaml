<UserControl x:Class="BIM.IFC.Export.UI.EPYSActorInfoTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:p="clr-namespace:BIM.IFC.Export.UI.Properties"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BIM.IFC.Export.UI"
             mc:Ignorable="d"
             d:DesignHeight="271" d:DesignWidth="594">
   <UserControl.Resources>
      <Style x:Key="FieldLabel" TargetType="Label">
         <Setter Property="HorizontalAlignment" Value="Left"/>
         <Setter Property="VerticalAlignment" Value="Center"/>
         <Setter Property="Padding" Value="0,0,4,0"/>
      </Style>
      <Style x:Key="FieldBox" TargetType="TextBox">
         <Setter Property="Height" Value="22"/>
         <Setter Property="VerticalAlignment" Value="Center"/>
         <Setter Property="Margin" Value="0,1,0,1"/>
      </Style>
      <Style x:Key="GroupHeader" TargetType="Label">
         <Setter Property="FontWeight" Value="Bold"/>
         <Setter Property="Padding" Value="0,6,0,2"/>
      </Style>
   </UserControl.Resources>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="10,6,10,10">

         <CheckBox x:Name="checkBox_UseEPYSActorInfo"
                   Content="{x:Static p:Resources.EPYSUseActorInfo}"
                   Margin="0,4,0,2" VerticalContentAlignment="Center"
                   Checked="checkBox_UseEPYSActorInfo_Changed"
                   Unchecked="checkBox_UseEPYSActorInfo_Changed"/>
         <CheckBox x:Name="checkBox_ValidateOnExport"
                   Content="{x:Static p:Resources.EPYSValidateOnExport}"
                   Margin="0,2,0,2" VerticalContentAlignment="Center"/>
         <CheckBox x:Name="checkBox_ApplyToApplicationDeveloper"
                   Content="{x:Static p:Resources.EPYSApplyToApplicationDeveloper}"
                   Margin="0,2,0,2" VerticalContentAlignment="Center"/>
         <TextBlock x:Name="textBlock_RequiredNote"
                    Text="{x:Static p:Resources.EPYSRequiredFieldNote}"
                    TextWrapping="Wrap" FontStyle="Italic" Opacity="0.75" Margin="0,2,0,4"/>

         <!--
            Georeferencing. The IFC export GeoReference tab has no field for these four,
            so without them IfcProjectedCRS.VerticalDatum / .MapProjection / .MapZone and
            IfcMapConversion.Scale can only be set through Revit project parameters.
            As everywhere on this tab, a value entered here wins and a blank field leaves
            the exporter's own behaviour untouched.
         -->
         <Label x:Name="label_GeoRefGroup" Content="{x:Static p:Resources.EPYSGeoRefGroup}" Style="{StaticResource GroupHeader}"/>
         <TextBlock x:Name="textBlock_GeoRefNote" Text="{x:Static p:Resources.EPYSGeoRefNote}"
                    TextWrapping="Wrap" FontStyle="Italic" Opacity="0.75" Margin="0,0,0,4"/>
         <Grid x:Name="grid_GeoRef">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="200"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="16"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <Label x:Name="label_CRSVerticalDatum" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_CRSVerticalDatum" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_CRSMapProjection" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_CRSMapProjection" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_CRSMapZone" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_CRSMapZone" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_MapConversionScale" Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_MapConversionScale" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
                     LostFocus="textBox_MapConversionScale_LostFocus"/>
            <TextBlock x:Name="textBlock_MapConversionScaleValidation" Grid.Row="3" Grid.Column="2"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="#FFFB0404" FontWeight="Bold" Visibility="Hidden"/>
         </Grid>

         <!-- IfcProject -->
         <Label x:Name="label_ProjectGroup" Content="{x:Static p:Resources.EPYSProjectGroup}" Style="{StaticResource GroupHeader}"/>
         <TextBlock x:Name="textBlock_ProjectNote" Text="{x:Static p:Resources.EPYSProjectNote}"
                    TextWrapping="Wrap" FontStyle="Italic" Opacity="0.75" Margin="0,0,0,4"/>
         <Grid x:Name="grid_Project">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="200"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <Label x:Name="label_ProjectName" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_ProjectName" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_ProjectLongName" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_ProjectLongName" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_ProjectDescription" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_ProjectDescription" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_ProjectType" Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="comboBox_ProjectType" Grid.Row="3" Grid.Column="1" Height="22"
                      VerticalAlignment="Center" Margin="0,1,0,1"/>

            <Label x:Name="label_ProjectPhase" Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_ProjectPhase" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"/>
         </Grid>

         <!-- IfcPerson -->
         <Label x:Name="label_PersonGroup" Content="{x:Static p:Resources.EPYSPersonGroup}" Style="{StaticResource GroupHeader}"/>
         <Grid x:Name="grid_Person">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="200"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <Label x:Name="label_PersonIdentification" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_PersonIdentification" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_PersonFamilyName" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_PersonFamilyName" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_PersonGivenName" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_PersonGivenName" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_PersonRole" Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="comboBox_PersonRole" Grid.Row="3" Grid.Column="1" Height="22"
                      VerticalAlignment="Center" Margin="0,1,0,1"
                      SelectionChanged="comboBox_PersonRole_SelectionChanged"/>

            <Label x:Name="label_PersonUserDefinedRole" Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_PersonUserDefinedRole" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_PersonRoleDescription" Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_PersonRoleDescription" Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}"/>
         </Grid>

         <!-- IfcOrganization -->
         <Label x:Name="label_OrganizationGroup" Content="{x:Static p:Resources.EPYSOrganizationGroup}" Style="{StaticResource GroupHeader}"/>
         <Grid x:Name="grid_Organization">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="200"/>
               <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <Label x:Name="label_OrganizationIdentification" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_OrganizationIdentification" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_OrganizationName" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_OrganizationName" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_OrganizationDescription" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_OrganizationDescription" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_OrganizationRole" Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="comboBox_OrganizationRole" Grid.Row="3" Grid.Column="1" Height="22"
                      VerticalAlignment="Center" Margin="0,1,0,1"
                      SelectionChanged="comboBox_OrganizationRole_SelectionChanged"/>

            <Label x:Name="label_OrganizationUserDefinedRole" Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_OrganizationUserDefinedRole" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_OrganizationRoleDescription" Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_OrganizationRoleDescription" Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}"/>
         </Grid>

         <!-- IfcOrganization.Addresses -->
         <Label x:Name="label_AddressGroup" Content="{x:Static p:Resources.EPYSAddressGroup}" Style="{StaticResource GroupHeader}"/>
         <Grid x:Name="grid_Address">
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="200"/>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="22"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
               <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <Label x:Name="label_StreetAddress" Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_StreetAddress" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_City" Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_City" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_Region" Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_Region" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_PostalCode" Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_PostalCode" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_Country" Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_Country" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}"/>

            <Label x:Name="label_Telephone" Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_Telephone" Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}"
                     LostFocus="textBox_Telephone_LostFocus"/>
            <TextBlock x:Name="textBlock_TelephoneValidation" Grid.Row="5" Grid.Column="2"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="#FFFB0404" FontWeight="Bold" Visibility="Hidden"/>

            <Label x:Name="label_ElectronicMail" Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="textBox_ElectronicMail" Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}"
                     LostFocus="textBox_ElectronicMail_LostFocus"/>
            <TextBlock x:Name="textBlock_ElectronicMailValidation" Grid.Row="6" Grid.Column="2"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="#FFFB0404" FontWeight="Bold" Visibility="Hidden"/>
         </Grid>

         <!-- Where to go with questions about the E-PYS requirements themselves. -->
         <StackPanel Orientation="Horizontal" Margin="0,12,0,2" Opacity="0.8">
            <TextBlock Text="{x:Static p:Resources.EPYSSupportText}" VerticalAlignment="Center"/>
            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center">
               <!-- NavigateUri is a Uri and is set in code: binding a string resource to it
                    through x:Static throws at load time. -->
               <Hyperlink x:Name="hyperlink_Support"
                          RequestNavigate="hyperlink_RequestNavigate">
                  <Run Text="{x:Static p:Resources.EPYSSupportLink}"/>
               </Hyperlink>
            </TextBlock>
            <TextBlock Text="&#183;" Margin="6,0,6,0" VerticalAlignment="Center"/>
            <TextBlock VerticalAlignment="Center">
               <Hyperlink x:Name="hyperlink_Mail"
                          RequestNavigate="hyperlink_RequestNavigate">
                  <Run Text="{x:Static p:Resources.EPYSSupportMail}"/>
               </Hyperlink>
            </TextBlock>
         </StackPanel>

      </StackPanel>
   </ScrollViewer>
</UserControl>
